---
/**
 * Barra de navegación en el patrón del template: logo a la izquierda, menú
 * al centro y las acciones a la derecha. En el template son "Log in" y
 * "Sign up"; acá son "Contacto" y "Donar", que es lo que la Fundación
 * necesita que la gente haga.
 */
import { nav, site } from "../data/site";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const esActivo = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

// "Contacto" vive en las acciones de la derecha, no en el menú central.
const menu = nav.filter((n) => n.href !== "/contacto/");
---

<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a href="/" class="nav__marca" aria-label={`${site.name} — ir al inicio`}>
      <img
        class="nav__logotipo"
        src="/img/marca/cropped-Logotipo.png"
        alt={site.name}
        width="904"
        height="255"
      />
      <img
        class="nav__isotipo"
        src="/img/marca/Isotipo.png"
        alt={site.name}
        width="266"
        height="255"
      />
    </a>

    <nav class="nav__menu" aria-label="Navegación principal">
      <ul>
        {
          menu.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["nav__link", { "is-active": esActivo(item.href) }]}
                aria-current={esActivo(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__acciones">
      <a href="/contacto/" class="nav__link nav__link--suelto">Contacto</a>
      <a href="/contacto/#donar" class="btn btn--accent btn--sm">
        <Icon name="corazon" size={16} />
        Donar
      </a>
      <button
        type="button"
        class="nav__burger"
        data-burger
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <span class="visually-hidden">Abrir menú</span>
        <Icon name="menu" size={24} class="nav__burger-abrir" />
        <Icon name="cerrar" size={24} class="nav__burger-cerrar" />
      </button>
    </div>
  </div>

  <div class="nav__drawer" id="menu-movil" data-drawer hidden>
    <ul class="wrap">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class:list={[{ "is-active": esActivo(item.href) }]}>
              {item.label}
              <Icon name="arrow-right" size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .nav.is-scrolled {
    border-bottom-color: var(--border);
    box-shadow: var(--shadow-sm);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 5rem;
  }

  .nav__marca {
    display: inline-flex;
    align-items: center;
    flex: none;
    transition: opacity 0.2s var(--ease-out);
  }
  .nav__marca:hover {
    opacity: 0.85;
  }
  .nav__logotipo {
    width: auto;
    height: 2.4rem;
  }
  .nav__isotipo {
    display: none;
    width: auto;
    height: 2.3rem;
  }

  /* El menú al centro es lo que define la silueta del template. */
  .nav__menu {
    margin-inline: auto;
  }
  .nav__menu ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav__link {
    position: relative;
    display: block;
    padding: 0.5rem 0.9rem;
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--ink-700);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }
  .nav__link:hover {
    color: var(--azul-700);
    background: var(--neutro-100);
  }
  .nav__link.is-active {
    color: var(--azul-700);
    font-weight: 600;
  }
  .nav__link.is-active::after {
    content: "";
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 2px;
    background: var(--magenta-600);
  }

  .nav__acciones {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }
  .nav__link--suelto {
    padding-inline: 0.6rem;
  }

  .nav__burger {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--azul-900);
    cursor: pointer;
  }
  .nav__burger-cerrar {
    display: none;
  }
  .nav.is-open .nav__burger-abrir {
    display: none;
  }
  .nav.is-open .nav__burger-cerrar {
    display: block;
  }

  .nav__drawer {
    border-top: 1px solid var(--border);
    background: #fff;
  }
  .nav__drawer[hidden] {
    display: none;
  }
  .nav__drawer ul {
    list-style: none;
    padding: 0.5rem 0 1.25rem;
    margin: 0;
    display: grid;
  }
  .nav__drawer a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0.25rem;
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--azul-900);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .nav__drawer a.is-active {
    color: var(--magenta-700);
    font-weight: 600;
  }
  .nav__drawer a svg {
    color: var(--ink-400);
  }

  @media (max-width: 1000px) {
    .nav__menu,
    .nav__link--suelto {
      display: none;
    }
    .nav__burger {
      display: grid;
    }
    .nav__inner {
      justify-content: space-between;
    }
  }
  @media (max-width: 420px) {
    .nav__logotipo {
      display: none;
    }
    .nav__isotipo {
      display: block;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const drawer = document.querySelector<HTMLElement>("[data-drawer]");

  if (nav) {
    const onScroll = () => nav.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (burger && drawer && nav) {
    const cerrar = () => {
      nav.classList.remove("is-open");
      burger.setAttribute("aria-expanded", "false");
      drawer.hidden = true;
    };

    burger.addEventListener("click", () => {
      const abierto = nav.classList.toggle("is-open");
      burger.setAttribute("aria-expanded", String(abierto));
      drawer.hidden = !abierto;
    });

    drawer.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) cerrar();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) {
        cerrar();
        burger.focus();
      }
    });
  }
</script>
