---
import { nav, site } from "../data/site";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const esActivo = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="masthead" data-masthead>
  <div class="wrap masthead__inner">
    <a href="/" class="brand" aria-label={`${site.name} — ir al inicio`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="2.2"></circle>
          <path
            d="M20 9c-5 4.6-7.5 8-7.5 11.5A7.5 7.5 0 0 0 20 28a7.5 7.5 0 0 0 7.5-7.5C27.5 17 25 13.6 20 9Z"
            fill="currentColor"
            opacity="0.9"></path>
        </svg>
      </span>
      <span class="brand__text">
        <strong>Gente Grande</strong>
        <small>Fundación · Arica</small>
      </span>
    </a>

    <nav class="masthead__nav" aria-label="Navegación principal">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["navlink", { "is-active": esActivo(item.href) }]}
                aria-current={esActivo(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="masthead__actions">
      <a href="/#donar" class="btn btn--accent btn--sm">
        <Icon name="corazon" size={17} />
        Donar
      </a>
      <button
        type="button"
        class="burger"
        data-burger
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <span class="visually-hidden">Abrir menú</span>
        <Icon name="menu" size={24} class="burger__open" />
        <Icon name="cerrar" size={24} class="burger__close" />
      </button>
    </div>
  </div>

  <div class="drawer" id="menu-movil" data-drawer hidden>
    <ul class="wrap">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class:list={[{ "is-active": esActivo(item.href) }]}>
              {item.label}
              <Icon name="arrow-right" size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--sand-50) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }
  .masthead.is-scrolled {
    background: color-mix(in srgb, var(--sand-50) 94%, transparent);
    border-bottom-color: var(--border);
    box-shadow: 0 2px 20px -12px rgb(17 32 30 / 0.3);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--petrol-900);
    margin-inline-end: auto;
  }
  .brand__mark {
    width: 2.3rem;
    height: 2.3rem;
    color: var(--petrol-700);
    transition: transform 0.4s var(--ease-out);
  }
  .brand:hover .brand__mark {
    transform: rotate(-8deg) scale(1.05);
  }
  .brand__text {
    display: grid;
    line-height: 1.15;
  }
  .brand__text strong {
    font-family: var(--font-display);
    font-size: 1.12rem;
    letter-spacing: -0.015em;
  }
  .brand__text small {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .masthead__nav ul {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
  }
  .navlink {
    position: relative;
    display: block;
    padding: 0.45rem 0.8rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-700);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }
  .navlink::after {
    content: "";
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--terra-600);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s var(--ease-out);
  }
  .navlink:hover {
    color: var(--petrol-900);
    background: color-mix(in srgb, var(--petrol-100) 60%, transparent);
  }
  .navlink.is-active {
    color: var(--petrol-900);
    font-weight: 600;
  }
  .navlink.is-active::after {
    transform: scaleX(1);
  }

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .btn--sm {
    padding: 0.6rem 1.15rem;
    font-size: 0.92rem;
  }

  .burger {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--petrol-900);
    cursor: pointer;
  }
  .burger__close {
    display: none;
  }
  .masthead.is-open .burger__open {
    display: none;
  }
  .masthead.is-open .burger__close {
    display: block;
  }

  .drawer {
    border-top: 1px solid var(--border);
    background: var(--sand-50);
    overflow: hidden;
  }
  .drawer[hidden] {
    display: none;
  }
  .drawer ul {
    list-style: none;
    padding: 0.5rem 0 1.25rem;
    margin: 0;
    display: grid;
  }
  .drawer a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 0.25rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--petrol-900);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .drawer a.is-active {
    color: var(--terra-600);
  }
  .drawer a svg {
    color: var(--ink-400);
  }

  @media (max-width: 920px) {
    .masthead__nav {
      display: none;
    }
    .burger {
      display: grid;
    }
  }
  @media (max-width: 420px) {
    .masthead__actions .btn {
      display: none;
    }
  }
</style>

<script>
  const masthead = document.querySelector<HTMLElement>("[data-masthead]");
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const drawer = document.querySelector<HTMLElement>("[data-drawer]");

  // Sombra del header al hacer scroll.
  if (masthead) {
    const onScroll = () =>
      masthead.classList.toggle("is-scrolled", window.scrollY > 12);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Menú móvil.
  if (burger && drawer && masthead) {
    burger.addEventListener("click", () => {
      const abierto = masthead.classList.toggle("is-open");
      burger.setAttribute("aria-expanded", String(abierto));
      drawer.hidden = !abierto;
    });

    drawer.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) {
        masthead.classList.remove("is-open");
        burger.setAttribute("aria-expanded", "false");
        drawer.hidden = true;
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && masthead.classList.contains("is-open")) {
        masthead.classList.remove("is-open");
        burger.setAttribute("aria-expanded", "false");
        drawer.hidden = true;
        burger.focus();
      }
    });
  }
</script>
