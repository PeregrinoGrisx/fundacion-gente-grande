---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="pagehero">
  <div class="pagehero__glow" aria-hidden="true"></div>
  <div class="wrap">
    <span class="eyebrow" data-reveal="fade">{eyebrow}</span>
    <h1 data-reveal style="--reveal-delay:80ms">{title}</h1>
    {
      lead && (
        <p class="lead pagehero__lead" data-reveal style="--reveal-delay:180ms">
          {lead}
        </p>
      )
    }
  </div>
</section>

<style>
  .pagehero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--azul-900);
    color: var(--neutro-100);
    padding-block: clamp(4rem, 11vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }
  .pagehero h1 {
    color: #fff;
    font-size: var(--step-4);
    max-width: 22ch;
    margin-top: 1rem;
  }
  .pagehero__lead {
    margin-top: 1.4rem;
    max-width: 58ch;
    color: color-mix(in srgb, var(--azul-100) 88%, transparent);
  }
  .pagehero .eyebrow {
    color: var(--magenta-500);
  }

  /* Resplandor difuso que da profundidad sin cargar la pantalla. */
  .pagehero__glow {
    position: absolute;
    inset: auto -10% -60% 45%;
    z-index: -1;
    aspect-ratio: 1;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--azul-500) 55%, transparent),
      transparent 68%
    );
    filter: blur(10px);
    animation: flotar 18s ease-in-out infinite alternate;
  }
  @keyframes flotar {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-6%, -8%, 0) scale(1.12);
    }
  }
</style>
