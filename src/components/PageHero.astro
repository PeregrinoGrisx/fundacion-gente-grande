---
/**
 * Cabecera de página interna.
 *
 * El template solo trae portada, login y registro, así que esta pieza se
 * diseñó con su mismo lenguaje: banda pastel, etiqueta en versales, titular
 * y bajada, con la miga de pan arriba.
 */
import Icon from "./Icon.astro";

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** Tinte de fondo. Rota entre páginas para que no se vean todas iguales. */
  tono?: "lavanda" | "cielo" | "menta" | "rosa";
}
const { eyebrow, title, lead, tono = "lavanda" } = Astro.props;
---

<section class:list={["pagehero", `pagehero--${tono}`]}>
  <div class="wrap">
    <nav class="miga" aria-label="Miga de pan">
      <a href="/">Inicio</a>
      <Icon name="arrow-right" size={14} />
      <span aria-current="page">{title}</span>
    </nav>

    <div class="pagehero__texto">
      <span class="eyebrow" data-reveal="fade">{eyebrow}</span>
      <h1 data-reveal style="--reveal-delay:60ms">{title}</h1>
      {
        lead && (
          <p class="lead pagehero__lead" data-reveal style="--reveal-delay:140ms">
            {lead}
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .pagehero {
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(2.5rem, 5vw, 4rem);
  }
  .pagehero--lavanda {
    background: var(--lavanda);
  }
  .pagehero--cielo {
    background: var(--cielo);
  }
  .pagehero--menta {
    background: var(--menta);
  }
  .pagehero--rosa {
    background: var(--rosa);
  }

  .miga {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--fs-sm);
    color: var(--ink-500);
  }
  .miga a {
    color: var(--azul-700);
    text-decoration: none;
    font-weight: 500;
  }
  .miga a:hover {
    text-decoration: underline;
  }
  .miga svg {
    color: var(--ink-400);
  }
  .miga span {
    font-weight: 600;
    color: var(--azul-900);
  }

  .pagehero__texto {
    max-width: 46rem;
  }
  .pagehero h1 {
    font-size: var(--fs-display);
    line-height: 1.18;
  }
  .pagehero__lead {
    margin-top: 1.1rem;
    max-width: 58ch;
    color: var(--ink-700);
  }
</style>
