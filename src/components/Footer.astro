---
/**
 * Pie en el patrón del template: bloque de marca con suscripción a la
 * izquierda, columnas de enlaces al centro y una barra inferior con los
 * datos de contacto.
 */
import { contacto, site } from "../data/site";
import Icon from "./Icon.astro";

const columnas = [
  {
    titulo: "Fundación",
    links: [
      { label: "Historia", href: "/nosotros/#historia" },
      { label: "Misión y visión", href: "/nosotros/#mision" },
      { label: "Directorio", href: "/nosotros/#directorio" },
      { label: "Socios fundadores", href: "/nosotros/#fundadores" },
    ],
  },
  {
    titulo: "ELEAM",
    links: [
      { label: "¿Qué es el ELEAM?", href: "/eleam/" },
      { label: "Servicios", href: "/eleam/#servicios" },
      { label: "Postular", href: "/eleam/#postular" },
      { label: "Cómo llegar", href: "/eleam/#ubicacion" },
    ],
  },
  {
    titulo: "Transparencia",
    links: [
      { label: "Memorias y balances", href: "/recursos/" },
      { label: "Recursos transferidos", href: "/recursos/#recursos-transferidos" },
      { label: "Canal de denuncias", href: "/contacto/#denuncias" },
      { label: "Noticias", href: "/noticias/" },
    ],
  },
  {
    titulo: "Participa",
    links: [
      { label: "Donar", href: "/contacto/#donar" },
      { label: "Ser voluntario", href: "/contacto/#voluntariado" },
      { label: "Contacto", href: "/contacto/" },
    ],
  },
];

const redes = [
  { name: "facebook" as const, href: contacto.redes.facebook, label: "Facebook" },
  { name: "instagram" as const, href: contacto.redes.instagram, label: "Instagram" },
  { name: "youtube" as const, href: contacto.redes.youtube, label: "YouTube" },
].filter((r) => r.href);
---

<footer class="pie">
  <div class="wrap pie__grid">
    <div class="pie__marca">
      <span class="pie__iso">
        <img src="/img/marca/Isotipo.png" alt={site.name} width="266" height="255" />
      </span>
      <p class="pie__blurb">{site.description}</p>
      {
        redes.length > 0 && (
          <ul class="pie__redes">
            {redes.map((r) => (
              <li>
                <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.label}>
                  <Icon name={r.name} size={18} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      columnas.map((col) => (
        <nav class="pie__col" aria-label={col.titulo}>
          <h2>{col.titulo}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="pie__barra">
    <div class="wrap pie__barra-inner">
      <p>© {new Date().getFullYear()} {site.name} · RUT {site.rut} · {site.ley}</p>
      <ul class="pie__datos">
        <li>
          <Icon name="ubicacion" size={15} />
          {contacto.direccionPostal}
        </li>
        <li>
          <a href={`mailto:${contacto.email}`}>
            <Icon name="mail" size={15} />
            {contacto.email}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--azul-900);
    color: var(--cielo);
  }
  .pie__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 2.5rem;
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .pie__iso {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: #fff;
    border-radius: 50%;
  }
  .pie__iso img {
    width: 2.2rem;
    height: auto;
  }
  .pie__blurb {
    margin-top: 1.1rem;
    max-width: 32ch;
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: color-mix(in srgb, var(--cielo) 78%, transparent);
  }

  .pie__redes {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
  }
  .pie__redes a {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    color: var(--cielo);
    background: rgb(255 255 255 / 0.08);
    border-radius: var(--radius-sm);
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }
  .pie__redes a:hover {
    background: var(--magenta-600);
    color: #fff;
  }

  .pie__col h2 {
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1.1rem;
  }
  .pie__col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .pie__col a {
    color: color-mix(in srgb, var(--cielo) 80%, transparent);
    text-decoration: none;
    font-size: var(--fs-sm);
    transition:
      color 0.2s var(--ease-out),
      padding-left 0.2s var(--ease-out);
  }
  .pie__col a:hover {
    color: #fff;
    padding-left: 3px;
  }

  .pie__barra {
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }
  .pie__barra-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.35rem;
    font-size: var(--fs-sm);
    color: color-mix(in srgb, var(--cielo) 68%, transparent);
  }
  .pie__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pie__datos li,
  .pie__datos a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  .pie__datos a:hover {
    color: #fff;
  }
  .pie__datos svg {
    color: var(--magenta-500);
  }

  @media (max-width: 1000px) {
    .pie__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pie__marca {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .pie__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
