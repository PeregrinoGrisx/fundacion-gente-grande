---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Pendiente from "../components/Pendiente.astro";
import {
  donacion,
  historia,
  misionVision,
  servicios,
  site,
  testimonios,
} from "../data/site";

/** Valores que recorren la cinta bajo el hero. */
const valores = [
  "Dignidad",
  "Derechos",
  "Autonomía",
  "Comunidad",
  "Envejecimiento activo",
  "Sin infantilizar",
];

/** Las cifras, como piezas editoriales y no como tarjetas. */
const cifras = [
  { n: "2014", pie: "Operando en Arica desde", tinte: "lavanda" },
  { n: "11", pie: "Socios fundadores", tinte: "menta" },
  { n: "01", pie: "ELEAM fiscalizado por SENAMA", tinte: "cielo" },
  { n: "0", pie: "Pesos de lucro. Somos fundación", tinte: "rosa" },
];

const tintes = ["lavanda", "menta", "cielo", "rosa", "lavanda", "menta"];
---

<Base title={site.name} description={site.description}>
  <!-- ======================================================================
       HERO — composición asimétrica: el titular manda y ocupa el ancho,
       la imagen se sale del margen derecho y el isotipo queda de filigrana.
       ====================================================================== -->
  <section class="hero">
    <img
      class="hero__filigrana"
      src="/img/marca/Isotipo.png"
      alt=""
      aria-hidden="true"
      width="266"
      height="255"
    />

    <div class="wrap hero__inner">
      <div class="hero__texto">
        <p class="hero__kicker">
          <span class="punto" aria-hidden="true"></span>
          Fundación Gente Grande · Arica, Chile
        </p>

        <h1 class="hero__titular">
          <span class="l l1">La grandeza</span>
          <span class="l l2">tiene</span>
          <span class="l l3"><em>muchos años</em></span>
        </h1>

        <div class="hero__pie">
          <p class="hero__bajada">
            Promovemos el desarrollo pleno de las personas mayores con
            dignidad, derechos y una visión moderna del envejecimiento.
          </p>
          <div class="btn-row">
            <a href="/eleam/" class="btn">
              Conocer el ELEAM
              <Icon name="arrow-right" size={18} />
            </a>
            <a href="#donar" class="btn btn--ghost">Quiero aportar</a>
          </div>
        </div>
      </div>

      <figure class="hero__figura">
        <div class="hero__foto">
          <div class="hero__placeholder">
            <Icon name="comunidad" size={48} />
            <p>Fotografía principal</p>
          </div>
        </div>
        <figcaption class="hero__sello">
          <Icon name="escudo" size={17} />
          Fiscalizado por SENAMA
        </figcaption>
      </figure>
    </div>
  </section>

  <Pendiente que="Fotografía principal del hero (retrato de persona mayor, vertical) e imagen para compartir en redes (/public/img/og-default.jpg)." />

  <!-- ======================================================================
       CINTA — banda en movimiento continuo con los valores de la Fundación.
       ====================================================================== -->
  <div class="cinta" aria-hidden="true">
    <div class="cinta__pista">
      {
        [0, 1].map(() => (
          <span class="cinta__grupo">
            {valores.map((v) => (
              <span class="cinta__item">
                {v}
                <span class="cinta__sep">◆</span>
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>
  <p class="visually-hidden">
    Valores de la Fundación: {valores.join(", ")}.
  </p>

  <!-- ======================================================================
       CIFRAS — banda editorial. Números enormes, reglas finas, sin tarjetas.
       ====================================================================== -->
  <section class="section section--tight cifras" aria-label="La Fundación en cifras">
    <div class="wrap">
      <ul class="cifras__lista">
        {
          cifras.map((c, i) => (
            <li class={`cifra cifra--${c.tinte}`} data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="cifra__n">{c.n}</span>
              <span class="cifra__pie">{c.pie}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ======================================================================
       MISIÓN Y VISIÓN — partición a dos tonos a sangre completa.
       ====================================================================== -->
  <section class="particion" id="mision">
    <article class="particion__mitad particion__mitad--lavanda" data-reveal="left">
      <span class="particion__num" aria-hidden="true">01</span>
      <h2>Misión</h2>
      <p>{misionVision.mision}</p>
    </article>
    <article class="particion__mitad particion__mitad--menta" data-reveal="right">
      <span class="particion__num" aria-hidden="true">02</span>
      <h2>Visión</h2>
      <p>{misionVision.vision}</p>
    </article>
  </section>

  <!-- ======================================================================
       QUÉ HACEMOS — índice editorial: el título queda fijo mientras la lista
       numerada corre al lado. Reemplaza la grilla de tarjetas.
       ====================================================================== -->
  <section class="section indice">
    <div class="wrap indice__inner">
      <div class="indice__fijo">
        <span class="eyebrow">Qué hacemos</span>
        <h2>Cuidado que<br />respeta la<br /><em>autonomía</em></h2>
        <p class="indice__nota">{historia.resumen}</p>
        <a href="/eleam/" class="link-arrow">
          Ver todo sobre el ELEAM
          <Icon name="arrow-right" size={18} />
        </a>
      </div>

      <ol class="indice__lista">
        {
          servicios.map((s, i) => (
            <li
              class={`fila fila--${tintes[i % tintes.length]}`}
              data-reveal
              style={`--reveal-delay:${i * 60}ms`}
            >
              <span class="fila__n">{String(i + 1).padStart(2, "0")}</span>
              <div class="fila__cuerpo">
                <h3>{s.titulo}</h3>
                <p>{s.texto}</p>
              </div>
              <span class="fila__icono" aria-hidden="true">
                <Icon name={s.icono as any} size={22} />
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ======================================================================
       TESTIMONIOS — carrusel sobre pastel, cada ficha con su propio tinte.
       ====================================================================== -->
  <section class="section testim">
    <div class="wrap">
      <header class="testim__head" data-reveal>
        <span class="eyebrow">Voces de nuestra comunidad</span>
        <h2>Lo que nos cuentan residentes y familias</h2>
      </header>
    </div>

    <ul class="testim__pista" tabindex="0" aria-label="Testimonios, desliza para ver más">
      {
        testimonios.map((t, i) => (
          <li class={`ficha ficha--${tintes[i % tintes.length]}`}>
            <span class="ficha__comilla" aria-hidden="true">“</span>
            <blockquote>
              <p>{t.texto}</p>
              <footer>{t.autor}</footer>
            </blockquote>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ======================================================================
       DONAR — bloque a sangre, tipografía grande, sin caja.
       ====================================================================== -->
  <section class="donar" id="donar">
    <div class="wrap donar__inner">
      <div data-reveal="left">
        <span class="eyebrow">Suma tu aporte</span>
        <h2 class="donar__titular">
          Cada peso<br />se convierte en<br /><em>compañía</em>
        </h2>
      </div>
      <div class="donar__col" data-reveal="right">
        <p class="lead">{donacion.texto}</p>
        <div class="btn-row">
          <a href="/contacto/#donar" class="btn btn--accent">
            <Icon name="corazon" size={18} />
            Donar ahora
          </a>
          <a href="/recursos/" class="btn btn--outline-light">
            Ver en qué lo usamos
          </a>
        </div>
        <p class="donar__fino">{donacion.fineprint}</p>
      </div>
    </div>
    <Pendiente que="Medio de pago para donar: datos de transferencia o pasarela (Webpay / Mercado Pago). Hoy el botón lleva a Contacto." />
  </section>

  <!-- ======================================================================
       DENUNCIAS — franja sobria, sin adornos.
       ====================================================================== -->
  <section class="section section--tight">
    <div class="wrap denuncia" data-reveal>
      <div class="denuncia__texto">
        <span class="eyebrow">Canal oficial · Confidencial</span>
        <h2>Canal de denuncias</h2>
        <p>
          Si has sido testigo o víctima de irregularidades, maltrato o
          vulneración de derechos, tienes el derecho y la responsabilidad de
          reportarlo. Tu denuncia es confidencial.
        </p>
      </div>
      <a href="/contacto/#denuncias" class="btn">
        Realizar denuncia
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>
</Base>

<style>
  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--lavanda);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem);
  }
  .hero__filigrana {
    position: absolute;
    z-index: -1;
    top: -8%;
    left: -7%;
    width: clamp(22rem, 42vw, 40rem);
    height: auto;
    opacity: 0.14;
    rotate: -12deg;
    animation: respirar 20s ease-in-out infinite alternate;
  }
  @keyframes respirar {
    to {
      rotate: -6deg;
      scale: 1.08;
    }
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--azul-800);
  }
  .punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--magenta-600);
    animation: latir 2.6s ease-in-out infinite;
  }
  @keyframes latir {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.5);
      opacity: 0.55;
    }
  }

  /* El titular es la pieza de diseño: enorme, apretado, desbordando. */
  .hero__titular {
    margin-top: 1.1rem;
    font-size: clamp(2.5rem, 7.5vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--azul-900);
  }
  .hero__titular .l {
    display: block;
    opacity: 0;
    transform: translateY(0.5em);
    animation: entrar 1s var(--ease-out) forwards;
  }
  .l1 {
    animation-delay: 0.1s;
  }
  .l2 {
    animation-delay: 0.22s;
    padding-left: 0.14em;
  }
  .l3 {
    animation-delay: 0.34s;
    padding-left: 0.05em;
  }
  .hero__titular em {
    font-style: normal;
    color: var(--magenta-600);
  }
  @keyframes entrar {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__pie {
    display: grid;
    grid-template-columns: minmax(0, 24rem) auto;
    gap: 1.5rem 2.5rem;
    align-items: start;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in srgb, var(--azul-900) 18%, transparent);
    opacity: 0;
    animation: entrar 0.9s var(--ease-out) 0.6s forwards;
  }
  .hero__bajada {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--azul-800);
  }

  .hero__figura {
    position: relative;
    margin: 0;
    opacity: 0;
    animation: entrar 1.1s var(--ease-out) 0.3s forwards;
  }
  /* La foto se sale del margen derecho: rompe la caja y da profundidad. */
  .hero__foto {
    aspect-ratio: 3 / 4;
    margin-right: calc(-1 * clamp(1rem, 5vw, 5rem));
    border-radius: 999px 999px 2rem 2rem;
    overflow: hidden;
    background: var(--cielo);
    box-shadow: var(--shadow-lg);
  }
  .hero__placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    height: 100%;
    color: var(--azul-600);
  }
  .hero__placeholder p {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero__sello {
    position: absolute;
    bottom: 1.25rem;
    left: -1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.05rem;
    background: #fff;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-md);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--azul-800);
  }
  .hero__sello svg {
    color: var(--magenta-600);
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__figura {
      order: -1;
      max-width: 20rem;
    }
    .hero__foto {
      aspect-ratio: 4 / 3;
      margin-right: 0;
      border-radius: 2rem;
    }
    .hero__sello {
      left: auto;
      right: 0.75rem;
    }
    .hero__pie {
      grid-template-columns: 1fr;
    }
  }

  /* ===================== CINTA ===================== */
  .cinta {
    overflow: hidden;
    padding-block: 0.9rem;
    background: var(--azul-900);
    color: #fff;
  }
  .cinta__pista {
    display: flex;
    width: max-content;
    animation: correr 38s linear infinite;
  }
  .cinta:hover .cinta__pista {
    animation-play-state: paused;
  }
  .cinta__grupo {
    display: flex;
    flex: none;
  }
  .cinta__item {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    padding-right: 2.5rem;
    font-size: clamp(0.95rem, 1.7vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .cinta__sep {
    font-size: 0.5em;
    color: var(--magenta-500);
  }
  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }

  /* ===================== CIFRAS ===================== */
  .cifras__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--neutro-200);
  }
  .cifra {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.75rem);
    border-bottom: 1px solid var(--neutro-200);
    border-right: 1px solid var(--neutro-200);
    transition: background-color 0.4s var(--ease-out);
  }
  .cifra:last-child {
    border-right: 0;
  }
  .cifra--lavanda:hover {
    background: var(--lavanda);
  }
  .cifra--menta:hover {
    background: var(--menta);
  }
  .cifra--cielo:hover {
    background: var(--cielo);
  }
  .cifra--rosa:hover {
    background: var(--rosa);
  }
  .cifra__n {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--azul-600);
  }
  .cifra__pie {
    display: block;
    margin-top: 0.85rem;
    max-width: 16ch;
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--ink-500);
  }

  /* ===================== PARTICIÓN ===================== */
  .particion {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .particion__mitad {
    padding: clamp(2.5rem, 6vw, 5.5rem) clamp(1.5rem, 5vw, 4.5rem);
  }
  .particion__mitad--lavanda {
    background: var(--lavanda);
  }
  .particion__mitad--menta {
    background: var(--menta);
  }
  .particion__num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--azul-900) 24%, transparent);
  }
  .particion__mitad h2 {
    margin: 0.5rem 0 1.25rem;
    font-size: clamp(1.9rem, 3.5vw, 2.9rem);
    color: var(--azul-900);
  }
  .particion__mitad p {
    max-width: 44ch;
    font-size: 1.04rem;
    line-height: 1.65;
    color: var(--azul-800);
  }

  /* ===================== ÍNDICE ===================== */
  .indice__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .indice__fijo {
    position: sticky;
    top: 7.5rem;
  }
  .indice__fijo h2 {
    margin: 1rem 0 1.4rem;
    font-size: clamp(2rem, 4.5vw, 3.4rem);
  }
  .indice__fijo em {
    font-style: normal;
    color: var(--magenta-700);
  }
  .indice__nota {
    max-width: 34ch;
    margin-bottom: 1.5rem;
    color: var(--ink-500);
  }

  .indice__lista {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: fila;
    border-top: 1px solid var(--neutro-200);
  }
  .fila {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: start;
    padding: clamp(1.4rem, 2.5vw, 2rem) clamp(1rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--neutro-200);
    border-radius: var(--radius);
    transition:
      background-color 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }
  .fila--lavanda:hover {
    background: var(--lavanda);
  }
  .fila--menta:hover {
    background: var(--menta);
  }
  .fila--cielo:hover {
    background: var(--cielo);
  }
  .fila--rosa:hover {
    background: var(--rosa);
  }
  .fila:hover {
    transform: translateX(6px);
  }
  .fila__n {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--magenta-600);
    padding-top: 0.3rem;
  }
  .fila__cuerpo h3 {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    margin-bottom: 0.4rem;
    color: var(--azul-900);
  }
  .fila__cuerpo p {
    color: var(--ink-500);
    font-size: 0.97rem;
    max-width: 48ch;
  }
  .fila__icono {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--neutro-300);
    border-radius: 50%;
    color: var(--azul-600);
    transition:
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }
  .fila:hover .fila__icono {
    background: #fff;
    border-color: #fff;
  }

  @media (max-width: 900px) {
    .indice__inner {
      grid-template-columns: 1fr;
    }
    .indice__fijo {
      position: static;
    }
    .fila__icono {
      display: none;
    }
    .fila {
      grid-template-columns: auto 1fr;
    }
  }

  /* ===================== TESTIMONIOS ===================== */
  .testim {
    background: var(--cielo);
  }
  .testim__head {
    max-width: 30ch;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .testim__head h2 {
    margin-top: 0.9rem;
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    color: var(--azul-900);
  }

  .testim__pista {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0.4rem max(1.25rem, calc((100vw - var(--wrap)) / 2)) 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--azul-300) transparent;
  }
  .ficha {
    position: relative;
    flex: 0 0 min(86%, 23rem);
    scroll-snap-align: start;
    padding: 2.5rem 1.8rem 1.8rem;
    border-radius: 1.75rem 1.75rem 1.75rem 0.4rem;
    transition: transform 0.35s var(--ease-out);
  }
  .ficha:hover {
    transform: translateY(-5px);
  }
  .ficha--lavanda {
    background: var(--lavanda);
  }
  .ficha--menta {
    background: var(--menta);
  }
  .ficha--cielo {
    background: #fff;
  }
  .ficha--rosa {
    background: var(--rosa);
  }
  .ficha__comilla {
    position: absolute;
    top: 0.35rem;
    left: 1.5rem;
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--azul-900) 24%, transparent);
  }
  .ficha blockquote {
    margin: 0;
  }
  .ficha p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--azul-900);
  }
  .ficha footer {
    margin-top: 1.1rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  /* ===================== DONAR ===================== */
  .donar {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    background: var(--azul-900);
    color: #fff;
  }
  .donar__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .donar .eyebrow {
    color: var(--magenta-500);
  }
  .donar__titular {
    margin-top: 1rem;
