---
/**
 * Portada.
 *
 * Sigue el orden de secciones del template Nosic Sketch, adaptado a lo que
 * la Fundación tiene que comunicar. Los pasteles llevan el peso visual y
 * van rotando sección a sección; el azul y el magenta de marca quedan
 * reservados para botones, enlaces y las cifras, que es donde el color
 * tiene que significar algo.
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import fotoEdificio from "../assets/fotos-eleam/eleam-edificio.jpg";
import fotoActividades from "../assets/fotos/taller-manualidades.jpg";
import fotoComunidad from "../assets/fotos/comunidad-conversacion.jpg";
import fotoResidencia from "../assets/fotos-eleam/residente-celebracion.jpg";
import fotoFormacion from "../assets/fotos-eleam/visita-folclorica.jpg";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Pendiente from "../components/Pendiente.astro";
import Lineas from "../components/Lineas.astro";
import {
  contacto,
  denuncias,
  diferencias,
  donacion,
  formasDeAportar,
  historia,
  misionVision,
  site,
  testimonios,
  vinculacionAcademica,
} from "../data/site";

const cifras = [
  { n: "2014", pie: "Operando en Arica desde" },
  { n: "11", pie: "Socios fundadores" },
  { n: "60+", pie: "Años, desde donde acompañamos" },
  { n: "100%", pie: "Sin fines de lucro" },
];

const noticias = (await getCollection("noticias", ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString("es-CL", { day: "numeric", month: "long", year: "numeric" });

const tintesIcono = ["", "--cielo", "--menta", "--rosa"];
---

<Base title={site.name} description={site.description}>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="hero__foto">
      <Image
        src={fotoEdificio}
        alt="Vista aérea al atardecer del edificio del ELEAM de la Fundación Gente Grande en Arica"
        widths={[480, 820]}
        sizes="(max-width: 900px) 100vw, 62vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="wrap hero__inner">
      <div class="hero__texto">
        <span class="hero__kicker">Envejecimiento digno · Arica, Chile</span>
        <h1 class="hero__titulo">
          <span>La grandeza</span>
          <span>tiene muchos</span>
          <span class="hero__acento">años.</span>
        </h1>
        <p class="hero__bajada">
          Promovemos el desarrollo pleno de las personas mayores con dignidad,
          derechos y una visión moderna del envejecimiento.
        </p>
        <div class="btn-row">
          <a href="/eleam/" class="btn btn--lg">
            Conocer el ELEAM
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/contacto/#donar" class="btn btn--accent btn--lg">
            <Icon name="corazon" size={18} />
            Quiero aportar
          </a>
        </div>
      </div>

      <span class="hero__sello">
        <Icon name="escudo" size={17} />
        Fiscalizado por SENAMA
      </span>
    </div>

    <div class="wrap">
      <ul class="cifras">
        {
          cifras.map((c, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="cifras__n">{c.n}</span>
              <span class="cifras__pie">{c.pie}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== TESTIMONIOS (carrusel automático) ===================== -->
  <section class="section section--tight testim-seccion" aria-labelledby="testim-titulo">
    <div class="wrap testim__head">
      <header class="sechead sechead--left" data-reveal>
        <span class="eyebrow">Voces de nuestra comunidad</span>
        <h2 id="testim-titulo">Lo que nos cuentan familias y amigos</h2>
      </header>
      <div class="testim__controles">
        <button type="button" class="testim__btn testim__btn--atras" data-testim="anterior" aria-label="Testimonio anterior">
          <Icon name="arrow-right" size={18} />
        </button>
        <button type="button" class="testim__btn" data-testim="pausa" aria-pressed="false" aria-label="Pausar el carrusel">
          <span class="testim__icono-pausa" aria-hidden="true"></span>
        </button>
        <button type="button" class="testim__btn" data-testim="siguiente" aria-label="Testimonio siguiente">
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
    </div>

    <ul class="testim" data-testim="pista" tabindex="0" aria-label="Testimonios">
      {
        testimonios.map((t, i) => (
          <li class={`testim__item testim__item--${["lavanda", "cielo", "menta", "rosa"][i % 4]}`}>
            <figure>
              <Image
                class="testim__foto"
                src={t.foto}
                alt={`Retrato de ${t.nombre}`}
                widths={[96, 192]}
                sizes="96px"
                loading="lazy"
              />
              <blockquote>
                <p>“{t.texto}”</p>
              </blockquote>
              <figcaption>
                <strong>{t.nombre}</strong>
                <span>{t.rol}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </section>

  <Pendiente que="Las fotos son de stock (Envato Elements, licencia comercial) y son PROVISIONALES: hay que reemplazarlas por fotografías reales del ELEAM y sus residentes. Falta además la imagen para compartir en redes (/public/img/og-default.jpg)." />

  <!-- ===================== INSTITUCIONES (blanco) ===================== -->
  <section class="section section--tight instituciones">
    <div class="wrap">
      <p class="instituciones__titulo">
        Trabajamos en red con instituciones de la región
      </p>
      <ul class="instituciones__lista">
        {vinculacionAcademica.instituciones.map((i) => <li>{i}</li>)}
        <li>SENAMA</li>
      </ul>
    </div>
  </section>

  <!-- ===================== SERVICIOS (dos bloques pastel) ===================== -->
  <section class="section section--tight">
    <Lineas lado="derecha" desfase={8} />
    <div class="wrap">
      <div class="duo">
        <article class="duo__card duo__card--lavanda" data-reveal="left">
          <Image
            class="duo__foto"
            src={fotoResidencia}
            alt="Residente del ELEAM sonriendo con el pulgar arriba durante una celebración"
            widths={[480, 720, 960]}
            sizes="(max-width: 800px) 92vw, 45vw"
            loading="lazy"
          />
          <h2>Residencia de larga estadía</h2>
          <p>
            Un ELEAM en Arica fiscalizado por SENAMA desde 2014, con equipo
            multidisciplinario y programas de envejecimiento activo.
          </p>
          <a href="/eleam/" class="link-arrow">
            Conocer el ELEAM
            <Icon name="arrow-right" size={18} />
          </a>
        </article>

        <article class="duo__card duo__card--menta" data-reveal="right">
          <Image
            class="duo__foto"
            src={fotoFormacion}
            alt="Jóvenes con trajes folclóricos visitando a una residente del ELEAM"
            widths={[480, 720, 960]}
            sizes="(max-width: 800px) 92vw, 45vw"
            loading="lazy"
          />
          <h2>Conciencia y formación</h2>
          <p>
            Charlas, talleres y capacitaciones para cuidadores, familias y
            estudiantes, con enfoque de derechos y envejecimiento activo.
          </p>
          <a href="/nosotros/" class="link-arrow">
            Conocer la Fundación
            <Icon name="arrow-right" size={18} />
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== QUÉ NOS DIFERENCIA (cielo, imagen derecha) ===================== -->
  <section class="section section--cielo">
    <div class="wrap pareja">
      <div data-reveal="left">
        <span class="eyebrow">Qué nos diferencia</span>
        <h2>Una mirada distinta sobre la vejez</h2>
        <p class="lead">{historia.resumen}</p>

        <ul class="puntos">
          {
            diferencias.map((d) => (
              <li>
                <span class="puntos__icono" aria-hidden="true">
                  <Icon name={d.icono as any} size={20} />
                </span>
                <div>
                  <h3>{d.titulo}</h3>
                  <p>{d.texto}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="pareja__figura" data-reveal="right">
        <Image
          class="foto foto--alta"
          src={fotoActividades}
          alt="Personas mayores en un taller de manualidades"
          widths={[400, 600, 800]}
          sizes="(max-width: 900px) 92vw, 40vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ===================== NOTICIAS (lavanda) ===================== -->
  <section class="section section--lavanda">
    <Lineas lado="izquierda" desfase={4} />
    <div class="wrap">
      <header class="sechead" data-reveal>
        <span class="eyebrow">Noticias</span>
        <h2>Lo que pasa en la Fundación</h2>
        <p class="lead">
          Comunicados, novedades y actividades junto a residentes, familias,
          equipo y comunidad.
        </p>
      </header>

      {
        noticias.length > 0 ? (
          <div class="grid grid--3">
            {noticias.map((n, i) => (
              <article class="nota" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <a href={`/noticias/${n.id}/`}>
                  <div class={`nota__media nota__media${tintesIcono[(i + 1) % 4]}`}>
                    {n.data.imagen ? (
                      <img src={n.data.imagen} alt={n.data.imagenAlt ?? ""} loading="lazy" />
                    ) : (
                      <span class="nota__hueco" aria-hidden="true">
                        <Icon name="comunidad" size={26} />
                      </span>
                    )}
                  </div>
                  <div class="nota__cuerpo">
                    <time datetime={n.data.fecha.toISOString()}>{fmt(n.data.fecha)}</time>
                    <h3>{n.data.titulo}</h3>
                    <p>{n.data.resumen}</p>
                    <span class="link-arrow">
                      Leer más
                      <Icon name="arrow-right" size={17} />
                    </span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="center muted">Pronto publicaremos novedades acá.</p>
        )
      }
      <Pendiente que="Noticias reales del sitio anterior: el listado cargaba de forma dinámica y no se alcanzó a migrar." />
    </div>
  </section>

  <!-- ===================== NOSOTROS (bloque lavanda, imagen izquierda) ===================== -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="bloque bloque--lavanda pareja pareja--invertida">
        <div class="pareja__figura" data-reveal="left">
          <Image
            class="foto"
            src={fotoComunidad}
            alt="Personas mayores conversando y compartiendo"
            widths={[400, 600, 800]}
            sizes="(max-width: 900px) 88vw, 40vw"
            loading="lazy"
          />
        </div>
        <div data-reveal="right">
          <span class="eyebrow">Sobre nosotros</span>
          <h2>Una sociedad que no infantilice la vejez</h2>
          <p class="lead">{misionVision.vision}</p>
          <a href="/nosotros/" class="btn">
            Leer nuestra historia
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== OBJETIVOS (menta) ===================== -->
  <section class="section section--menta">
    <Lineas lado="derecha" desfase={-4} />
    <div class="wrap">
      <header class="sechead" data-reveal>
        <span class="eyebrow">Nuestros objetivos</span>
        <h2>En qué trabajamos todos los días</h2>
      </header>
      <div class="grid grid--3">
        {
          historia.objetivos.map((o, i) => (
            <article class="card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <Image
                class="card__foto"
                src={o.foto}
                alt={o.fotoAlt}
                widths={[360, 540, 720]}
                sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 30vw"
                loading="lazy"
              />
              <div class={`card__icon card__icon${tintesIcono[i % 4]}`}>
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3>{o.titulo}</h3>
              <p>{o.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== FORMAS DE APORTAR (rosa) ===================== -->
  <section class="section section--rosa" id="aportar">
    <div class="wrap">
      <header class="sechead" data-reveal>
        <span class="eyebrow">Cómo ayudar</span>
        <h2>Tres formas de aportar</h2>
        <p class="lead">
          No todo se resuelve con dinero. El tiempo y las redes pesan igual.
        </p>
      </header>

      <div class="grid grid--3 planes">
        {
          formasDeAportar.map((f, i) => (
            <article
              class:list={["plan", { "plan--destacado": f.destacado }]}
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              {f.destacado && <span class="plan__cinta">Más necesario</span>}
              <h3>{f.titulo}</h3>
              <p class="plan__resumen">{f.resumen}</p>
              <ul class="plan__lista">
                {f.incluye.map((item) => (
                  <li>
                    <Icon name="check-circle" size={17} />
                    {item}
                  </li>
                ))}
              </ul>
              <a
                href={f.href}
                class:list={["btn", f.destacado ? "btn--light" : "btn--ghost"]}
              >
                {f.cta}
              </a>
            </article>
          ))
        }
      </div>
      <p class="center fineprint" style="margin-top:1.5rem">{donacion.fineprint}</p>
    </div>
  </section>

  <!-- ===================== CTA (oscuro) ===================== -->
  <section class="cta">
    <div class="wrap-medio center" data-reveal="scale">
      <h2>Empieza a aportar hoy a la vejez digna en Arica</h2>
      <p class="lead">{donacion.texto}</p>
      <div class="btn-row" style="justify-content:center">
        <a href="/contacto/#donar" class="btn btn--accent btn--lg">
          <Icon name="corazon" size={18} />
          Donar ahora
        </a>
        <a href="/recursos/" class="btn btn--outline-light btn--lg">
          Ver en qué lo usamos
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== CONTACTO (cielo) ===================== -->
  <section class="section section--cielo">
    <div class="wrap">
      <header class="sechead" data-reveal>
        <span class="eyebrow">¿Cómo podemos ayudarte?</span>
        <h2>Escríbenos</h2>
      </header>

      <div class="grid grid--3">
        <article class="card" data-reveal>
          <div class="card__icon"><Icon name="mano" size={22} /></div>
          <h3>Quiero colaborar</h3>
          <p>Voluntariado, donaciones de insumos, charlas o alianzas.</p>
          <a href="/contacto/#voluntariado" class="link-arrow">
            Escribir
            <Icon name="arrow-right" size={17} />
          </a>
        </article>

        <article class="card" data-reveal style="--reveal-delay:80ms">
          <div class="card__icon card__icon--menta"><Icon name="comunidad" size={22} /></div>
          <h3>Consultas sobre el ELEAM</h3>
          <p>Postulaciones, visitas y coordinación con familias.</p>
          <a href="/eleam/#postular" class="link-arrow">
            Ver información
            <Icon name="arrow-right" size={17} />
          </a>
        </article>

        <article class="card" data-reveal style="--reveal-delay:160ms">
          <div class="card__icon card__icon--rosa"><Icon name="escudo" size={22} /></div>
          <h3>Canal de denuncias</h3>
          <p>{denuncias.intro.slice(0, 130)}…</p>
          <ul class="garantias">
            {denuncias.garantias.map((g) => <li>{g}</li>)}
          </ul>
          <a href={`mailto:${contacto.email}?subject=Denuncia`} class="link-arrow">
            Realizar denuncia
            <Icon name="arrow-right" size={17} />
          </a>
        </article>
      </div>
    </div>
  </section>
</Base>

<script>
  // Carrusel de testimonios: avanza una ficha cada INTERVALO ms y vuelve al
  // inicio al llegar al final. Se detiene con el botón de pausa, al pasar el
  // mouse, al enfocarlo con teclado o cuando no está en pantalla.
  const INTERVALO = 6000;

  const pista = document.querySelector<HTMLElement>('[data-testim="pista"]');
  const btnPausa = document.querySelector<HTMLButtonElement>('[data-testim="pausa"]');
  const btnAnterior = document.querySelector<HTMLButtonElement>('[data-testim="anterior"]');
  const btnSiguiente = document.querySelector<HTMLButtonElement>('[data-testim="siguiente"]');

  if (pista && btnPausa && btnAnterior && btnSiguiente) {
    const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let pausadoPorPersona = reducido;
    let encima = false;
    let visible = false;
    let timer: number | undefined;

    const paso = () => {
      const ficha = pista.querySelector<HTMLElement>(".testim__item");
      const gap = parseFloat(getComputedStyle(pista).columnGap) || 0;
      return ficha ? ficha.offsetWidth + gap : pista.clientWidth;
    };
    const alFinal = () => pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 4;
    const alInicio = () => pista.scrollLeft <= 4;
    const comportamiento = (): ScrollBehavior => (reducido ? "auto" : "smooth");

    const siguiente = () =>
      alFinal()
        ? pista.scrollTo({ left: 0, behavior: comportamiento() })
        : pista.scrollBy({ left: paso(), behavior: comportamiento() });
    const anterior = () =>
      alInicio()
        ? pista.scrollTo({ left: pista.scrollWidth, behavior: comportamiento() })
        : pista.scrollBy({ left: -paso(), behavior: comportamiento() });

    const programar = () => {
      window.clearInterval(timer);
      timer = undefined;
      if (!pausadoPorPersona && !encima && visible && !document.hidden) {
        timer = window.setInterval(siguiente, INTERVALO);
      }
    };

    const marcarPausa = (pausado: boolean) => {
      pausadoPorPersona = pausado;
      btnPausa.setAttribute("aria-pressed", String(pausado));
      btnPausa.setAttribute("aria-label", pausado ? "Reanudar el carrusel" : "Pausar el carrusel");
      programar();
    };
    marcarPausa(pausadoPorPersona);

    btnPausa.addEventListener("click", () => marcarPausa(!pausadoPorPersona));
    btnSiguiente.addEventListener("click", () => {
      siguiente();
      programar();
    });
    btnAnterior.addEventListener("click", () => {
      anterior();
      programar();
    });

    const seccion = pista.closest("section") ?? pista;
    seccion.addEventListener("pointerenter", () => {
      encima = true;
      programar();
    });
    seccion.addEventListener("pointerleave", () => {
      encima = false;
      programar();
    });
    seccion.addEventListener("focusin", () => {
      encima = true;
      programar();
    });
    seccion.addEventListener("focusout", (e) => {
      if (!seccion.contains(e.relatedTarget as Node | null)) {
        encima = false;
        programar();
      }
    });
    document.addEventListener("visibilitychange", programar);

    new IntersectionObserver(([entrada]) => {
      visible = entrada.isIntersecting;
      programar();
    }, { threshold: 0.4 }).observe(pista);
  }
</script>

<style>
  /* ===================== HERO =====================
     Fondo del color de la página con el texto a la izquierda y la foto del
     edificio del ELEAM a la derecha. La foto se funde hacia la izquierda y
     hacia abajo con una máscara (no con un degradado blanco encima), así
     se mezcla con el fondo que haya: blanco, o el oscuro del modo noche.
     ================================================================= */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2.5rem, 5vw, 4rem);
    background: var(--bg);
  }

  .hero__foto {
    position: absolute;
    top: 0;
    right: 0;
    z-index: -1;
    width: min(66%, 64rem);
    height: 100%;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.45) 22%, #000 46%),
      linear-gradient(to bottom, #000 58%, transparent 96%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.45) 22%, #000 46%),
      linear-gradient(to bottom, #000 58%, transparent 96%);
    mask-composite: intersect;
  }
  .hero__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 55%;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
    min-height: clamp(26rem, 42vw, 34rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .hero__texto {
    align-self: center;
  }

  .hero__kicker {
    display: inline-block;
    margin-bottom: 1.1rem;
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-700);
  }

  .hero__titulo {
    font-size: clamp(2.6rem, 7.2vw, 6.25rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.04em;
    color: var(--ink-900);
  }
  .hero__titulo span {
    display: block;
  }
  .hero__acento {
    color: var(--accent-text);
  }

  .hero__bajada {
    margin: 1.5rem 0 2.1rem;
    max-width: 42ch;
    font-size: var(--fs-md);
    line-height: 1.65;
    color: var(--ink-700);
  }

  /* Sello sobre la foto, abajo a la derecha */
  .hero__sello {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    background: var(--surface);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-md);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-900);
  }
  .hero__sello svg {
    color: var(--link);
  }

  /* --- Cifras --------------------------------------------------------- */
  .cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    list-style: none;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0;
    background: var(--surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }
  .cifras li {
