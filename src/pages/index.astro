---
/**
 * Portada.
 *
 * Sigue el orden de secciones del template Nosic Sketch, adaptado a lo que
 * la Fundación tiene que comunicar:
 *
 *   hero + cifras → instituciones → servicios → qué nos diferencia →
 *   noticias → nosotros → objetivos → vinculación → formas de aportar →
 *   testimonios → CTA → contacto/denuncias
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Pendiente from "../components/Pendiente.astro";
import {
  contacto,
  denuncias,
  diferencias,
  donacion,
  formasDeAportar,
  historia,
  misionVision,
  servicios,
  site,
  testimonios,
  vinculacionAcademica,
} from "../data/site";

const cifras = [
  { n: "2014", pie: "Operando en Arica desde" },
  { n: "11", pie: "Socios fundadores" },
  { n: "60+", pie: "Años, desde donde acompañamos" },
  { n: "100%", pie: "Sin fines de lucro" },
];

const noticias = (await getCollection("noticias", ({ data }) => !data.borrador))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString("es-CL", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={site.name} description={site.description}>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__texto">
        <span class="eyebrow">Envejecimiento digno · Arica, Chile</span>
        <h1 class="hero__titulo">
          La grandeza tiene <span>muchos años</span>
        </h1>
        <p class="hero__bajada">
          Promovemos el desarrollo pleno de las personas mayores con dignidad,
          derechos y una visión moderna del envejecimiento. Desde Arica para
          todo Chile.
        </p>
        <div class="btn-row">
          <a href="/eleam/" class="btn btn--lg">
            Conocer el ELEAM
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/contacto/#donar" class="btn btn--ghost btn--lg">
            <Icon name="corazon" size={18} />
            Quiero aportar
          </a>
        </div>
      </div>

      <figure class="hero__figura">
        <div class="hero__foto">
          <div class="hero__hueco">
            <Icon name="comunidad" size={52} />
            <p>Fotografía principal</p>
          </div>
        </div>
        <span class="hero__sello">
          <Icon name="escudo" size={18} />
          Fiscalizado por SENAMA
        </span>
      </figure>
    </div>

    <!-- Barra de cifras montada sobre el borde, como en el template. -->
    <div class="wrap">
      <ul class="cifras">
        {
          cifras.map((c, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="cifras__n">{c.n}</span>
              <span class="cifras__pie">{c.pie}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Pendiente que="Fotografía principal del hero e imagen para compartir en redes (/public/img/og-default.jpg)." />

  <!-- ===================== INSTITUCIONES ===================== -->
  <section class="section section--tight instituciones">
    <div class="wrap">
      <p class="instituciones__titulo">
        Trabajamos en red con instituciones de la región
      </p>
      <ul class="instituciones__lista">
        {
          vinculacionAcademica.instituciones.map((i) => (
            <li>{i}</li>
          ))
        }
        <li>SENAMA</li>
      </ul>
    </div>
  </section>

  <!-- ===================== SERVICIOS (2 bloques grandes) ===================== -->
  <section class="section">
    <div class="wrap">
      <div class="grid grid--2 duo">
        <article class="duo__card duo__card--lavanda" data-reveal="left">
          <div class="duo__media" aria-hidden="true">
            <Icon name="comunidad" size={38} />
          </div>
          <h2>Residencia de larga estadía</h2>
          <p>
            Un ELEAM en Arica fiscalizado por SENAMA desde 2014, con equipo
            multidisciplinario y programas de envejecimiento activo.
          </p>
          <a href="/eleam/" class="link-arrow">
            Conocer el ELEAM
            <Icon name="arrow-right" size={18} />
          </a>
        </article>

        <article class="duo__card duo__card--menta" data-reveal="right">
          <div class="duo__media" aria-hidden="true">
            <Icon name="megafono" size={38} />
          </div>
          <h2>Conciencia y formación</h2>
          <p>
            Charlas, talleres y capacitaciones para cuidadores, familias y
            estudiantes, con enfoque de derechos y envejecimiento activo.
          </p>
          <a href="/nosotros/" class="link-arrow">
            Conocer la Fundación
            <Icon name="arrow-right" size={18} />
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== QUÉ NOS DIFERENCIA ===================== -->
  <section class="section section--alt">
    <div class="wrap dif">
      <div class="dif__texto" data-reveal="left">
        <span class="eyebrow">Qué nos diferencia</span>
        <h2>Una mirada distinta sobre la vejez</h2>
        <p class="lead">{historia.resumen}</p>

        <ul class="dif__lista">
          {
            diferencias.map((d) => (
              <li>
                <span class="dif__icono" aria-hidden="true">
                  <Icon name={d.icono as any} size={20} />
                </span>
                <div>
                  <h3>{d.titulo}</h3>
                  <p>{d.texto}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="dif__figura" data-reveal="right">
        <div class="dif__hueco">
          <Icon name="actividad" size={44} />
          <p>Fotografía de actividades</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== NOTICIAS ===================== -->
  <section class="section">
    <div class="wrap">
      <header class="sechead" data-reveal>
        <span class="eyebrow">Noticias</span>
        <h2>Lo que pasa en la Fundación</h2>
        <p class="lead">
          Comunicados, novedades y actividades junto a residentes, familias,
          equipo y comunidad.
        </p>
      </header>

      {
        noticias.length > 0 ? (
          <div class="grid grid--3">
            {noticias.map((n, i) => (
              <article class="card nota" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <a href={`/noticias/${n.id}/`}>
                  <div class="nota__media">
                    {n.data.imagen ? (
                      <img src={n.data.imagen} alt={n.data.imagenAlt ?? ""} loading="lazy" />
                    ) : (
                      <span class="nota__hueco" aria-hidden="true">
                        <Icon name="comunidad" size={26} />
                      </span>
                    )}
                  </div>
                  <time datetime={n.data.fecha.toISOString()}>{fmt(n.data.fecha)}</time>
                  <h3>{n.data.titulo}</h3>
                  <p>{n.data.resumen}</p>
                  <span class="link-arrow">
                    Leer más
                    <Icon name="arrow-right" size={17} />
                  </span>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="center muted">Pronto publicaremos novedades acá.</p>
        )
      }
      <Pendiente que="Noticias reales del sitio anterior: el listado cargaba de forma dinámica y no se alcanzó a migrar." />
    </div>
  </section>

  <!-- ===================== NOSOTROS ===================== -->
  <section class="section section--lavanda">
    <div class="wrap dos-col">
      <div data-reveal="left">
        <span class="eyebrow">Sobre nosotros</span>
        <h2>Nuestra visión es una sociedad que no infantilice la vejez</h2>
      </div>
      <div class="dos-col__texto" data-reveal="right">
        <p class="lead">{misionVision.vision}</p>
        <a href="/nosotros/" class="btn">
          Leer nuestra historia
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== OBJETIVOS ===================== -->
  <section class="section">
    <div class="wrap">
      <header class="sechead" data-reveal>
        <span class="eyebrow">Nuestros objetivos</span>
        <h2>En qué trabajamos todos los días</h2>
      </header>
      <div class="grid grid--3">
        {
          historia.objetivos.map((o, i) => (
            <article class="card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <div class="card__icon card__icon--lavanda">
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3>{o.titulo}</h3>
              <p>{o.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== FORMAS DE APORTAR ===================== -->
  <section class="section section--alt" id="aportar">
    <div class="wrap">
      <header class="sechead" data-reveal>
        <span class="eyebrow">Cómo ayudar</span>
        <h2>Tres formas de aportar</h2>
        <p class="lead">
          No todo se resuelve con dinero. El tiempo y las redes pesan igual.
        </p>
      </header>

      <div class="grid grid--3 planes">
        {
          formasDeAportar.map((f, i) => (
            <article
              class:list={["plan", { "plan--destacado": f.destacado }]}
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              {f.destacado && <span class="plan__cinta">Más necesario</span>}
              <h3>{f.titulo}</h3>
              <p class="plan__resumen">{f.resumen}</p>
              <ul class="plan__lista">
                {f.incluye.map((item) => (
                  <li>
                    <Icon name="check-circle" size={17} />
                    {item}
                  </li>
                ))}
              </ul>
              <a
                href={f.href}
                class:list={["btn", f.destacado ? "btn--light" : "btn--ghost"]}
              >
                {f.cta}
              </a>
            </article>
          ))
        }
      </div>
      <p class="center fineprint" style="margin-top:1.5rem">{donacion.fineprint}</p>
    </div>
  </section>

  <!-- ===================== TESTIMONIOS ===================== -->
  <section class="section">
    <div class="wrap">
      <header class="sechead" data-reveal>
        <span class="eyebrow">Voces de nuestra comunidad</span>
        <h2>Lo que nos cuentan residentes y familias</h2>
      </header>
    </div>

    <ul class="testim" tabindex="0" aria-label="Testimonios, desliza para ver más">
      {
        testimonios.map((t) => (
          <li class="testim__item">
            <Icon name="cita" size={26} class="testim__icono" />
            <blockquote>
              <p>{t.texto}</p>
              <footer>{t.autor}</footer>
            </blockquote>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="cta">
    <div class="wrap-medio center" data-reveal="scale">
      <h2>Empieza a aportar hoy a la vejez digna en Arica</h2>
      <p class="lead">{donacion.texto}</p>
      <div class="btn-row" style="justify-content:center">
        <a href="/contacto/#donar" class="btn btn--accent btn--lg">
          <Icon name="corazon" size={18} />
          Donar ahora
        </a>
        <a href="/recursos/" class="btn btn--outline-light btn--lg">
          Ver en qué lo usamos
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== CONTACTO Y DENUNCIAS ===================== -->
  <section class="section">
    <div class="wrap">
      <header class="sechead" data-reveal>
        <span class="eyebrow">¿Cómo podemos ayudarte?</span>
        <h2>Escríbenos</h2>
      </header>

      <div class="grid grid--3">
        <article class="card" data-reveal>
          <div class="card__icon card__icon--lavanda"><Icon name="mano" size={22} /></div>
          <h3>Quiero colaborar</h3>
          <p>Voluntariado, donaciones de insumos, charlas o alianzas.</p>
          <a href="/contacto/#voluntariado" class="link-arrow">
            Escribir
            <Icon name="arrow-right" size={17} />
          </a>
        </article>

        <article class="card" data-reveal style="--reveal-delay:80ms">
          <div class="card__icon"><Icon name="comunidad" size={22} /></div>
          <h3>Consultas sobre el ELEAM</h3>
          <p>Postulaciones, visitas y coordinación con familias.</p>
          <a href="/eleam/#postular" class="link-arrow">
            Ver información
            <Icon name="arrow-right" size={17} />
          </a>
        </article>

        <article class="card card--denuncia" data-reveal style="--reveal-delay:160ms">
          <div class="card__icon card__icon--rosa"><Icon name="escudo" size={22} /></div>
          <h3>Canal de denuncias</h3>
          <p>{denuncias.intro.slice(0, 150)}…</p>
          <ul class="garantias">
            {denuncias.garantias.map((g) => <li>{g}</li>)}
          </ul>
          <a href={`mailto:${contacto.email}?subject=Denuncia`} class="link-arrow">
            Realizar denuncia
            <Icon name="arrow-right" size={17} />
          </a>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===================== HERO ===================== */
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    background: linear-gradient(180deg, var(--lavanda) 0%, var(--lavanda) 62%, #fff 62%);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .hero__titulo {
    font-size: var(--fs-display);
    line-height: 1.18;
    max-width: 14ch;
  }
  .hero__titulo span {
    color: var(--magenta-700);
  }
  .hero__bajada {
    margin: 1.25rem 0 2rem;
    max-width: 46ch;
    font-size: var(--fs-md);
    color: var(--ink-700);
    line-height: 1.7;
  }

  .hero__figura {
    position: relative;
    margin: 0;
  }
  .hero__foto {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-md);
  }
  .hero__hueco {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    height: 100%;
    color: var(--azul-500);
  }
  .hero__hueco p {
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero__sello {
    position: absolute;
    bottom: -1rem;
    left: -1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--azul-900);
  }
  .hero__sello svg {
    color: var(--magenta-600);
  }

  /* Barra de cifras: tarjeta blanca montada sobre el cambio de fondo. */
  .cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    list-style: none;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .cifras li {
    padding-inline: 1rem;
    border-right: 1px solid var(--border);
  }
  .cifras li:last-child {
    border-right: 0;
  }
  .cifras__n {
    display: block;
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 1.1;
    color: var(--azul-600);
  }
  .cifras__pie {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .hero {
      background: linear-gradient(180deg, var(--lavanda) 0%, var(--lavanda) 78%, #fff 78%);
    }
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__figura {
      order: -1;
    }
    .hero__sello {
      left: auto;
      right: 0.75rem;
      bottom: -0.75rem;
    }
    .cifras li {
      border-right: 0;
      border-bottom: 1px solid var(--border);
      padding-block: 0.9rem;
    }
    .cifras li:last-child {
      border-bottom: 0;
    }
  }

  /* ===================== INSTITUCIONES ===================== */
  .instituciones__titulo {
    text-align: center;
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-400);
    margin-bottom: 1.5rem;
  }
  .instituciones__lista {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 2.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .instituciones__lista li {
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--ink-400);
    transition: color 0.2s var(--ease-out);
  }
  .instituciones__lista li:hover {
    color: var(--azul-600);
  }

  /* ===================== DUO ===================== */
  .duo__card {
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    border-radius: var(--radius-xl);
  }
  .duo__card--lavanda {
    background: var(--lavanda);
  }
  .duo__card--menta {
    background: var(--menta);
  }
  .duo__media {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 1.5rem;
    background: #fff;
    border-radius: var(--radius-lg);
    color: var(--azul-600);
  }
  .duo__card h2 {
    font-size: var(--fs-h2);
    margin-bottom: 0.75rem;
  }
  .duo__card p {
    margin-bottom: 1.25rem;
    color: var(--ink-700);
    max-width: 44ch;
  }

  /* ===================== DIFERENCIAS ===================== */
  .dif {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .dif__lista {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1.5rem;
  }
  .dif__lista li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }
  .dif__icono {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: #fff;
    border-radius: var(--radius);
    color: var(--azul-600);
    box-shadow: var(--shadow-sm);
  }
  .dif__lista h3 {
    font-size: var(--fs-lg);
    margin-bottom: 0.2rem;
  }
  .dif__lista p {
    font-size: var(--fs-base);
    color: var(--text-muted);
  }
  .dif__hueco {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    aspect-ratio: 4 / 5;
    background: #fff;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    color: var(--azul-500);
  }
  .dif__hueco p {
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .dif {
      grid-template-columns: 1fr;
    }
    .dif__hueco {
      aspect-ratio: 3 / 2;
    }
  }

  /* ===================== NOTICIAS ===================== */
  .nota {
    padding: 0;
    overflow: hidden;
  }
  .nota a {
    display: block;
    padding: 0 1.5rem 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  .nota__media {
    aspect-ratio: 16 / 9;
    margin: 0 -1.5rem 1.25rem;
    background: var(--lavanda);
    overflow: hidden;
  }
  .nota__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nota__hueco {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--azul-500);
  }
  .nota time {
    font-size: var(--fs-sm);
    color: var(--ink-400);
  }
  .nota h3 {
    font-size: var(--fs-lg);
    margin: 0.35rem 0 0.5rem;
  }
  .nota p {
    margin-bottom: 1rem;
    font-size: var(--fs-base);
  }

  /* ===================== DOS COLUMNAS ===================== */
  .dos-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .dos-col h2 {
    font-size: var(--fs-h1);
    max-width: 18ch;
  }
  .dos-col__texto .lead {
    margin-bottom: 1.75rem;
    color: var(--ink-700);
  }
  @media (max-width: 860px) {
    .dos-col {
      grid-template-columns: 1fr;
    }
  }

  /* ===================== OBJETIVOS ===================== */
  .num {
    font-size: var(--fs-lg);
    font-weight: 700;
  }

  /* ===================== PLANES ===================== */
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .plan:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .plan--destacado {
    background: var(--azul-900);
    border-color: var(--azul-900);
    color: #fff;
  }
  .plan--destacado h3 {
    color: #fff;
  }
  .plan__cinta {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    padding: 0.25rem 0.7rem;
    background: var(--magenta-600);
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
  }
  .plan h3 {
    font-size: var(--fs-h3);
  }
