---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { contacto, enMedios, enRedes } from "../data/site";

const entradas = (await getCollection("noticias", ({ data }) => !data.borrador)).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

/** Reproductor de Facebook para un video (sin cargar el SDK). */
const videoFacebook = (url: string) =>
  `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(decodeURI(url))}&show_text=false&width=560&t=0`;

const fmt = (d: Date) =>
  d.toLocaleDateString("es-CL", { day: "numeric", month: "long", year: "numeric" });
---

<Base
  title="Noticias"
  description="Comunicados, novedades y actividades de la Fundación Gente Grande de Arica."
>
  <PageHero
    tono="rosa"
        eyebrow="Noticias y galería"
    title="Lo que pasa en la Fundación"
    lead="Comunicados, novedades y actividades compartidas junto a residentes, familias, equipo y comunidad."
  />

  <section class="section">
    <div class="wrap">
      {
        entradas.length > 0 && (
          <ul class="noticias">
            {entradas.map((n, i) => (
              <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <a href={`/noticias/${n.id}/`} class="nota">
                  <div class="nota__media">
                    {n.data.imagen ? (
                      <img
                        src={n.data.imagen}
                        alt={n.data.imagenAlt ?? ""}
                        loading="lazy"
                      />
                    ) : (
                      <span class="nota__hueco" aria-hidden="true">
                        <Icon name="comunidad" size={30} />
                      </span>
                    )}
                    <span class="nota__cat">{n.data.categoria}</span>
                  </div>
                  <div class="nota__cuerpo">
                    <time datetime={n.data.fecha.toISOString()}>{fmt(n.data.fecha)}</time>
                    <h2>{n.data.titulo}</h2>
                    <p>{n.data.resumen}</p>
                    <span class="link-arrow">
                      Leer más
                      <Icon name="arrow-right" size={18} />
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <!-- ===== En los medios ===== -->
      <header class="sechead sechead--left" data-reveal>
        <span class="eyebrow">Prensa</span>
        <h2>La Fundación en los medios</h2>
      </header>
      <div class="medios">
        {
          enMedios.map((m, i) =>
            m.video ? (
              <article class="medio medio--video" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <div class="medio__video">
                  <iframe
                    src={videoFacebook(m.url)}
                    title={`Video: ${m.titulo}`}
                    loading="lazy"
                    allow="encrypted-media; picture-in-picture; web-share"
                    allowfullscreen
                  />
                </div>
                <div class="medio__texto">
                  <span class="medio__fuente">{m.tipo} · {m.medio}</span>
                  <h3>{m.titulo}</h3>
                  <a href={m.url} target="_blank" rel="noopener noreferrer" class="link-arrow">
                    {m.cta}
                    <Icon name="arrow-right" size={18} />
                  </a>
                </div>
              </article>
            ) : (
              <a
                href={m.url}
                target="_blank"
                rel="noopener noreferrer"
                class="medio"
                data-reveal
                style={`--reveal-delay:${i * 70}ms`}
              >
                <span class="medio__fuente">
                  {m.tipo} · {m.medio}
                  {m.fecha && ` · ${m.fecha}`}
                </span>
                <h3>{m.titulo}</h3>
                <span class="link-arrow">
                  {m.cta}
                  <Icon name="arrow-right" size={18} />
                </span>
              </a>
            ),
          )
        }
      </div>
    </div>
  </section>

  <!-- ===== En nuestras redes (Instagram incrustado) ===== -->
  <section class="section section--rosa" id="redes">
    <div class="wrap">
      <header class="sechead sechead--left" data-reveal>
        <span class="eyebrow">Instagram</span>
        <h2>En nuestras redes</h2>
        <p class="lead">
          Reels y fotos de las actividades del ELEAM y de la Fundación. Síguenos en
          <a href={contacto.redes.instagram} target="_blank" rel="noopener noreferrer">@fundaciongentegrande</a>.
        </p>
      </header>
      <div class="ig-grid">
        {
          enRedes.map(({ url, incrustar }) =>
            incrustar ? (
              <blockquote
                class="instagram-media"
                data-instgrm-permalink={url}
                data-instgrm-version="14"
                data-instgrm-captioned
              >
                <a href={url} target="_blank" rel="noopener noreferrer">
                  Ver esta publicación en Instagram
                </a>
              </blockquote>
            ) : (
              <a href={url} target="_blank" rel="noopener noreferrer" class="ig-enlace">
                <Icon name="instagram" size={34} />
                <strong>Reel de la Fundación</strong>
                <span class="link-arrow">
                  Verlo en Instagram
                  <Icon name="arrow-right" size={18} />
                </span>
              </a>
            ),
          )
        }
      </div>
    </div>
  </section>
  <!-- Código oficial de Instagram: convierte cada blockquote en la publicación. -->
  <script is:inline async src="https://www.instagram.com/embed.js"></script>
</Base>

<style>
  /* --- Prensa --- */
  .medios {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .medio {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  a.medio:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .medio--video {
    grid-row: span 2;
    padding: 0;
    overflow: hidden;
  }
  .medio__video {
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .medio__video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .medio__texto {
    display: grid;
    gap: 0.7rem;
    padding: 1.4rem 1.6rem 1.6rem;
  }
  .medio__fuente {
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .medio h3 {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  /* --- Instagram --- */
  .ig-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: start;
  }
  /* Instagram fija un ancho mínimo de 326 px: en celulares chicos se libera. */
  .ig-grid :global(.instagram-media),
  .ig-grid :global(iframe.instagram-media) {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 540px !important;
    margin: 0 auto !important;
    border-radius: var(--radius-lg) !important;
  }
  /* Reels que Instagram no deja incrustar: tarjeta con enlace */
  .ig-enlace {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    min-height: 14rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    color: var(--text-strong);
    text-align: center;
    text-decoration: none;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  .ig-enlace:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .ig-enlace :global(svg:first-child) {
    color: var(--accent-text);
  }
  /* Antes de que cargue el código de Instagram se ve una tarjeta con enlace. */
  .ig-grid blockquote {
    display: grid;
    place-items: center;
    min-height: 12rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    text-align: center;
  }

  @media (max-width: 860px) {
    .medios {
      grid-template-columns: minmax(0, 1fr);
    }
    .medio--video {
      grid-row: auto;
    }
  }

  .noticias {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .nota {
    display: grid;
    height: 100%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }
  .nota:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--azul-300);
  }
  .nota__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--azul-100);
  }
  .nota__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .nota:hover .nota__media img {
    transform: scale(1.05);
  }
  .nota__hueco {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--link);
  }
  .nota__cat {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.3rem 0.75rem;
    background: var(--surface);
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--link-strong);
  }
  .nota__cuerpo {
    padding: 1.5rem;
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }
  .nota__cuerpo time {
    font-size: 0.8rem;
    color: var(--ink-400);
  }
  .nota__cuerpo h2 {
    font-size: var(--fs-lg);
  }
  .nota__cuerpo p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .nota__cuerpo .link-arrow {
    margin-top: 0.4rem;
    font-size: 0.92rem;
  }
</style>
