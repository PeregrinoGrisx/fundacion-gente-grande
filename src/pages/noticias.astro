---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Pendiente from "../components/Pendiente.astro";

const entradas = (await getCollection("noticias", ({ data }) => !data.borrador)).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("es-CL", { day: "numeric", month: "long", year: "numeric" });
---

<Base
  title="Noticias"
  description="Comunicados, novedades y actividades de la Fundación Gente Grande de Arica."
>
  <PageHero
    eyebrow="Noticias y galería"
    title="Lo que pasa en la Fundación"
    lead="Comunicados, novedades y actividades compartidas junto a residentes, familias, equipo y comunidad."
  />

  <section class="section">
    <div class="wrap">
      {
        entradas.length > 0 ? (
          <ul class="noticias">
            {entradas.map((n, i) => (
              <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <a href={`/noticias/${n.id}/`} class="nota">
                  <div class="nota__media">
                    {n.data.imagen ? (
                      <img
                        src={n.data.imagen}
                        alt={n.data.imagenAlt ?? ""}
                        loading="lazy"
                      />
                    ) : (
                      <span class="nota__hueco" aria-hidden="true">
                        <Icon name="comunidad" size={30} />
                      </span>
                    )}
                    <span class="nota__cat">{n.data.categoria}</span>
                  </div>
                  <div class="nota__cuerpo">
                    <time datetime={n.data.fecha.toISOString()}>{fmt(n.data.fecha)}</time>
                    <h2>{n.data.titulo}</h2>
                    <p>{n.data.resumen}</p>
                    <span class="link-arrow">
                      Leer más
                      <Icon name="arrow-right" size={18} />
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="card center stack" data-reveal>
            <h2 style="font-size:var(--step-2)">Aún no hay noticias publicadas</h2>
            <p class="muted">
              Pronto compartiremos acá los comunicados y actividades de la
              Fundación.
            </p>
          </div>
        )
      }

      <Pendiente que="Noticias reales del sitio antiguo (el listado no se alcanzó a migrar porque cargaba de forma dinámica) y fotos para la galería de actividades." />
    </div>
  </section>
</Base>

<style>
  .noticias {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .nota {
    display: grid;
    height: 100%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }
  .nota:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--azul-300);
  }
  .nota__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--azul-100);
  }
  .nota__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .nota:hover .nota__media img {
    transform: scale(1.05);
  }
  .nota__hueco {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--azul-600);
  }
  .nota__cat {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.3rem 0.75rem;
    background: var(--surface);
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--azul-700);
  }
  .nota__cuerpo {
    padding: 1.5rem;
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }
  .nota__cuerpo time {
    font-size: 0.8rem;
    color: var(--ink-400);
  }
  .nota__cuerpo h2 {
    font-size: var(--step-1);
  }
  .nota__cuerpo p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .nota__cuerpo .link-arrow {
    margin-top: 0.4rem;
    font-size: 0.92rem;
  }
</style>
