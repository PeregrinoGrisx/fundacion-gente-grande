---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  /** Imagen para compartir en redes, relativa a /public. */
  image?: string;
}

const {
  title,
  description = site.description,
  image = "/img/og-default.jpg",
} = Astro.props;

const tituloCompleto = title === site.name ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2275b7" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/img/marca/Isotipo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/marca/Isotipo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "NGO",
        name: site.name,
        alternateName: site.shortName,
        description: site.description,
        url: site.url,
        foundingDate: String(site.foundedYear),
        taxID: site.rut,
        address: {
          "@type": "PostalAddress",
          streetAddress: "Volcán Cotacotani #131",
          addressLocality: "Arica",
          addressRegion: "Arica y Parinacota",
          addressCountry: "CL",
        },
      })}
    />
  </head>

  <body>
    <a href="#contenido" class="skip-link">Ir al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <button type="button" class="to-top" data-to-top aria-label="Volver arriba">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>

    <style>
      .to-top {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 90;
        display: grid;
        place-items: center;
        width: 2.9rem;
        height: 2.9rem;
        background: var(--azul-700);
        color: #fff;
        border: none;
        border-radius: 50%;
        box-shadow: var(--shadow-md);
        cursor: pointer;
        opacity: 0;
        transform: translateY(12px) scale(0.9);
        pointer-events: none;
        transition:
          opacity 0.3s var(--ease-out),
          transform 0.3s var(--ease-out),
          background-color 0.2s var(--ease-out);
      }
      .to-top.is-shown {
        opacity: 1;
        transform: none;
        pointer-events: auto;
      }
      .to-top:hover {
        background: var(--azul-900);
      }
    </style>

    <script>
      /* --- Revelado al entrar en viewport -------------------------------- */
      const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revelables = document.querySelectorAll<HTMLElement>("[data-reveal]");

      if (reducido) {
        revelables.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        revelables.forEach((el) => observer.observe(el));
      }

      /* --- Contadores animados ------------------------------------------- */
      const contadores = document.querySelectorAll<HTMLElement>("[data-count]");
      const animarContador = (el: HTMLElement) => {
        const destino = Number(el.dataset.count ?? "0");
        const esAnio = el.dataset.countFormat === "year";
        if (reducido || esAnio) {
          el.textContent = String(destino);
          return;
        }
        const duracion = 1500;
        const inicio = performance.now();
        const paso = (ahora: number) => {
          const t = Math.min((ahora - inicio) / duracion, 1);
          // easeOutExpo: arranca rápido y aterriza suave.
          const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
          el.textContent = String(Math.round(destino * eased));
          if (t < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
      };

      if (contadores.length) {
        const obsCount = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              animarContador(entry.target as HTMLElement);
              obsCount.unobserve(entry.target);
            });
          },
          { threshold: 0.5 },
        );
        contadores.forEach((el) => obsCount.observe(el));
      }

      /* --- Botón volver arriba ------------------------------------------- */
      const toTop = document.querySelector<HTMLButtonElement>("[data-to-top]");
      if (toTop) {
        const sync = () => toTop.classList.toggle("is-shown", window.scrollY > 700);
        sync();
        window.addEventListener("scroll", sync, { passive: true });
        toTop.addEventListener("click", () =>
          window.scrollTo({ top: 0, behavior: reducido ? "auto" : "smooth" }),
        );
      }
    </script>
  </body>
</html>
