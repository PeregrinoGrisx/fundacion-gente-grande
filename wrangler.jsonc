// Despliegue en Cloudflare Workers (solo archivos estáticos de dist/).
// Cada push a main publica solo (.github/workflows/deploy.yml). A mano:
// `npm run build` y luego `npx wrangler deploy`.
// El dominio fundaciongentegrandearica.org se conecta como Custom Domain del Worker.
{
  "name": "fundacion-gente-grande",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "fundaciongentegrandearica.org", "custom_domain": true },
    { "pattern": "www.fundaciongentegrandearica.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
